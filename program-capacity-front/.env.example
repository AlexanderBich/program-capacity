# Base path of the backend API. Same-origin by design: Vite proxies it in development, nginx in Docker.
VITE_API_URL=/api/v1

# true: the sign-in page offers the seeded demo accounts. Never enable outside a local demo.
VITE_SHOW_DEMO_ACCOUNTS=true
# Only read when VITE_SHOW_DEMO_ACCOUNTS is true. Matches SEED_PASSWORD in the backend.
VITE_DEMO_PASSWORD=capacity-demo-password
