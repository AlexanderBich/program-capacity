# Every variable below is required unless marked optional: the app validates them with zod at boot
# and refuses to start when one is missing. Values here are for local development only.

NODE_ENV=development

# --- HTTP server ---
SERVER_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# How many reverse proxies sit in front of the API (0 when it is reached directly).
TRUST_PROXY_HOPS=0
# Requests per minute, per signed-in user (per client IP before signing in).
API_RATE_LIMIT_PER_MINUTE=600
# Sent by orchestrator probes in the x-probe-token header (the health endpoints have no user session).
PROBE_TOKEN=local-probe-token-change-me
# Basic-auth credentials protecting /api/docs.
SWAGGER_USERNAME=docs
SWAGGER_PASSWORD=docs-local-password

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=55432
DB_USER=capacity
DB_PASS=capacity
DB_NAME=capacity
DB_SSL=false
DB_POOL_SIZE=20
DB_STATEMENT_TIMEOUT_MS=30000
# A transaction left idle this long is killed: it may be holding a program's row lock.
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Authentication ---
JWT_SECRET=local-development-secret-at-least-32-chars
JWT_ISSUER=program-capacity
JWT_AUDIENCE=program-capacity-clients
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
# Set to true anywhere the API is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Login attempts per minute, per client IP.
AUTH_RATE_LIMIT_PER_MINUTE=20
# Login attempts per minute, per account, wherever they come from.
AUTH_ACCOUNT_RATE_LIMIT_PER_MINUTE=10

# --- Capacity ---
# How long a request waits for a program's row lock before answering 503.
CAPACITY_LOCK_TIMEOUT_MS=3000
# Local changes newer than (snapshot.asOf - grace) survive a reconciliation: treasury cannot have
# seen them yet. Covers feed latency and clock skew between the two systems.
RECONCILIATION_GRACE_SECONDS=300
AVAILABILITY_STREAM_HEARTBEAT_SECONDS=20
# Open availability streams per user, per replica. One per browser tab in normal use.
AVAILABILITY_STREAM_MAX_PER_USER=10

# --- FX ---
# Cross-currency reservations are refused when the newest published rate is older than this.
FX_MAX_RATE_AGE_SECONDS=86400

# --- Kafka ---
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=program-capacity
KAFKA_CONSUMER_GROUP_ID=program-capacity
KAFKA_SSL=false
# Optional: set both to authenticate with SASL/SCRAM-SHA-512.
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_TREASURY_CAPACITY=treasury.capacity.v1
KAFKA_TOPIC_TREASURY_FX_RATES=treasury.fx-rates.v1
KAFKA_TOPIC_DEAD_LETTER=treasury.dead-letter.v1
KAFKA_TOPIC_CAPACITY_EVENTS=program-capacity.events.v1

# --- Feature flags ---
KAFKA_CONSUMER_ENABLED=true
CRONS_ENABLED=true

# --- Development only (src/dev) ---
SEED_PASSWORD=capacity-demo-password
